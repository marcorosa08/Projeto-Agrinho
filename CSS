*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f6f8;
    padding:20px;
}

.container{
    max-width:1000px;
    margin:auto;
}

h1{
    text-align:center;
    color:#27ae60;
    margin-bottom:20px;
}

.card,
.resultado{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
    margin-bottom:20px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:15px;
    margin-bottom:20px;
}

.mini-card{
    background:white;
    padding:20px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.mini-card h3{
    color:#555;
    margin-bottom:10px;
}

.mini-card span{
    font-size:24px;
    font-weight:bold;
    color:#27ae60;
}

label{
    display:block;
    margin-top:12px;
    font-weight:bold;
}

input,
select{
    width:100%;
    padding:10px;
    border:1px solid #ccc;
    border-radius:6px;
    margin-top:5px;
}

button{
    width:100%;
    padding:12px;
    margin-top:12px;
    border:none;
    border-radius:6px;
    cursor:pointer;
    color:white;
    font-size:16px;
}

.btn-calcular{
    background:#27ae60;
}

.btn-pdf{
    background:#3498db;
}

.btn-limpar{
    background:#e74c3c;
}

button:hover{
    opacity:.9;
}

.resultado{
    display:none;
}

.resultado h2{
    color:#27ae60;
    margin-bottom:15px;
}

.resultado p{
    margin:8px 0;
}

hr{
    margin:15px 0;
}

.grafico-container{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}

canvas{
    width:100%;
    max-height:400px;
}

@media(max-width:768px){

    .cards{
        grid-template-columns:1fr;
    }

    h1{
        font-size:24px;
    }

}
